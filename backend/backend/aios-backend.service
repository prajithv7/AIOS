[Unit]
Description=AIOS FastAPI backend (uvicorn on Turso/libSQL)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/c/Users/Asus/Downloads/Aiso/backend
ExecStart=/mnt/c/Users/Asus/Downloads/Aiso/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# Keep inherited env (PATH to venv) intact; venv is invoked by absolute path.
User=prajith

[Install]
WantedBy=multi-user.target
